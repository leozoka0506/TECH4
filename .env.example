# Gere valores únicos com python scripts/setup_env.py. Nunca versione o .env.
DATABASE_URL=postgresql://escuta:SUBSTITUA@127.0.0.1:5433/escuta
DB_PASSWORD=SUBSTITUA
DB_ADMIN_PASSWORD=SUBSTITUA
APP_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO_32_CARACTERES
APP_ENV=development
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen2.5:3b
EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
EMBEDDING_DIMENSIONS=768
VERIFY_CLAIMS=true
RESPONSE_MODE=extractive
RATE_LIMIT_PER_MINUTE=20
ALLOW_PAID_API=false
